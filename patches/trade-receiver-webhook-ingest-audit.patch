+def test_alerts_include_webhook_ingest_metadata(client, db_session: Session, monkeypatch):
+    user, _ = _seed_paid_user(db_session)
+    token = "user-api-key"
+    user.api_key_hash = hashlib.sha256(token.encode()).hexdigest()
+    db_session.commit()
+
+    create = client.post(
+        "/v1/me/webhooks",
+        json={"name": "TradingView"},
+        headers={"Authorization": f"Bearer {token}"},
+    )
+    assert create.status_code == 200
+    webhook = create.json()
+
+    monkeypatch.setattr("app.services.market_hours.is_rth", lambda now=None: False)
+    ingest = client.post(
+        f"/v1/webhooks/{webhook['id']}",
+        json={"title": "Alert", "body": "BTO SPY 580C 6/20 @ 2.50", "symbol": "SPY"},
+        headers={"X-Forwarded-For": "203.0.113.10"},
+    )
+    assert ingest.status_code == 200
+
+    res = client.get("/v1/me/alerts", headers={"Authorization": f"Bearer {token}"})
+    assert res.status_code == 200
+    items = res.json()
+    assert len(items) == 1
+    item = items[0]
+    assert item["ingest_source"] == "webhook"
+    assert item["webhook_id"] == webhook["id"]
+    assert item["webhook_name"] == "TradingView"
+    assert item["source_ip"] == "203.0.113.10"
+    assert '"symbol": "SPY"' in item["raw_payload"]
