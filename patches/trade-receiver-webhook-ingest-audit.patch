+def client_ip(request: Request) -> str | None:
+    forwarded = request.headers.get("x-forwarded-for")
+    if forwarded:
+        ip = forwarded.split(",")[0].strip()
+        return ip[:64] if ip else None
+    if request.client:
+        return request.client.host[:64]
+    return None
+
