+def _legacy_webhook_id(alert: InboundAlert, webhook_ids: set[str]) -> str | None:
+    if ":" not in alert.idempotency_key:
+        return None
+    prefix, _ = alert.idempotency_key.split(":", 1)
+    if prefix in webhook_ids:
+        return prefix
+    return None
+
+
+def _resolve_ingest_source(alert: InboundAlert, webhook_ids: set[str]) -> tuple[IngestSource, str | None]:
+    webhook_id = alert.webhook_id or _legacy_webhook_id(alert, webhook_ids)
+    if alert.ingest_source == "webhook" or webhook_id is not None:
+        return "webhook", webhook_id
+    return "desktop", None
+
+
+def _webhook_display_name(webhook_names: dict[str, str], webhook_id: str | None) -> str | None:
+    if not webhook_id:
+        return None
+    name = webhook_names.get(webhook_id, "").strip()
+    return name or None
+
