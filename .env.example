# Required in production and when BETTER_AUTH_URL is not localhost (see src/lib/auth-config.ts).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Same PostgreSQL database as trade-receiver
DATABASE_URL=postgresql://trade:trade@localhost:5432/trade

INTERNAL_API_SECRET=dev-internal-secret
VITE_RECEIVER_API_URL=http://localhost:8000
VITE_SITE_URL=https://tradedesky.chapilabs.com

# Boop error reporting (Sentry-compatible)
# Format: key@domain (https:// and /1 are added automatically)
# Used server-side at runtime and baked into the client bundle at build time.
# Client events are tunneled through the app so the key is not sent directly to Boop from the browser.
SENTRY_DSN=boop_proj_...@boop.chapilabs.com
